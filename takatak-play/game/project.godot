; Engine configuration file.
; Takatak Play — Godot 4 game client (Phase 2 + anganwadi demo build). Renderer: Compatibility (GLES3) for the Pi 5.

config_version=5

[application]

config/name="Takatak Play"
config/description="Motion games for kids. Talks to the vision service over ws://127.0.0.1:8765."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/max_fps=60

[autoload]

Settings="*res://autoload/Settings.gd"
ContentDB="*res://autoload/ContentDB.gd"
Centre="*res://autoload/Centre.gd"
VisionClient="*res://autoload/VisionClient.gd"
AudioDirector="*res://autoload/AudioDirector.gd"
Stats="*res://autoload/Stats.gd"
InputRouter="*res://autoload/InputRouter.gd"
GameManager="*res://autoload/GameManager.gd"
SessionDirector="*res://autoload/SessionDirector.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.19, 1)
